<Window x:Class="FileGroupy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FileGroupy.Views"
        xmlns:viewModels="clr-namespace:FileGroupy.ViewModels"
        Title="FileGroupy" Width="1320" Height="840" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackgroundBrush}">
  <Window.Resources>
    <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
      <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:FileExplorerViewModel}">
      <views:FileExplorerView />
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="264" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Background="#101B31" Padding="18,18,16,18">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Top">
          <Border Background="#2563EB" Width="38" Height="38" CornerRadius="9" Margin="10,12,10,14" HorizontalAlignment="Left">
            <TextBlock Text="FG" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="FileGroupy" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="10,0,10,3" />
          <TextBlock Text="文件分类工作台" Foreground="#9AAAC0" FontSize="12" Margin="10,0,10,32" />
          <Border Background="#172842" CornerRadius="6" Padding="10,7" Margin="4,0,4,8">
            <TextBlock Text="工作区" Foreground="#9AAAC0" FontSize="11" FontWeight="SemiBold" />
          </Border>
          <Grid x:Name="NavigationMenuPanel" MouseLeave="NavigationMenuPanel_OnMouseLeave" SizeChanged="NavigationMenuPanel_OnSizeChanged">
            <Border x:Name="NavigationHoverSurface" Background="#284263" CornerRadius="6" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top">
              <Border.RenderTransform><TranslateTransform x:Name="NavigationHoverTransform" X="0" Y="0" /></Border.RenderTransform>
            </Border>
            <StackPanel>
              <Button x:Name="DashboardNavigationButton" Style="{StaticResource NavigationButton}" Command="{Binding ShowDashboardCommand}" MouseEnter="NavigationButton_OnMouseEnter">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center" />
                  <TextBlock Text="概览与分类" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="ExplorerNavigationButton" Style="{StaticResource NavigationButton}" Command="{Binding ShowExplorerCommand}" MouseEnter="NavigationButton_OnMouseEnter">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center" />
                  <TextBlock Text="全部文件" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Background="#172842" BorderBrush="#263D5C" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4,0,4,10">
          <StackPanel>
            <TextBlock Text="存储来源" Foreground="#9AAAC0" FontSize="11" />
            <TextBlock Text="本地磁盘和Mobile Phone设备" TextWrapping="Wrap" Foreground="#E6EDF8" FontSize="12" Margin="0,5,0,0" />
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Background="{StaticResource PageBackgroundBrush}" BorderBrush="#E5EAF1" BorderThickness="1,0,0,0">
      <ContentControl Content="{Binding CurrentViewModel}" />
    </Border>
  </Grid>
</Window>