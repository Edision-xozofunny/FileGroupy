<Window x:Class="FileGroupy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FileGroupy.Views"
        xmlns:viewModels="clr-namespace:FileGroupy.ViewModels"
        Title="FileGroupy" Width="1320" Height="840" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackgroundBrush}">
  <Window.Resources>
    <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Foreground" Value="#C9D4E5" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#21314A" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="Background" Value="#2B4770" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
      <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:FileExplorerViewModel}">
      <views:FileExplorerView />
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="264" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Background="#101B31" Padding="18,18,16,18">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Top">
          <Border Background="#2563EB" Width="38" Height="38" CornerRadius="9" Margin="10,12,10,14" HorizontalAlignment="Left">
            <TextBlock Text="FG" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="FileGroupy" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="10,0,10,3" />
          <TextBlock Text="文件分类工作台" Foreground="#9AAAC0" FontSize="12" Margin="10,0,10,32" />
          <TextBlock Text="工作区" Foreground="#71829B" FontSize="11" FontWeight="SemiBold" Margin="12,0,0,8" />
          <Button Style="{StaticResource NavigationButton}" Command="{Binding ShowDashboardCommand}">
            <TextBlock Text="概览与分类" />
          </Button>
          <Button Style="{StaticResource NavigationButton}" Command="{Binding ShowExplorerCommand}">
            <TextBlock Text="全部文件" />
          </Button>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Background="#172842" CornerRadius="8" Padding="12" Margin="4,0,4,10">
          <StackPanel>
            <TextBlock Text="存储来源" Foreground="#9AAAC0" FontSize="11" />
            <TextBlock Text="本地磁盘和Mobile Phone设备" TextWrapping="Wrap" Foreground="#E6EDF8" FontSize="12" Margin="0,5,0,0" />
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Background="{StaticResource PageBackgroundBrush}" BorderBrush="#E5EAF1" BorderThickness="1,0,0,0">
      <ContentControl Content="{Binding CurrentViewModel}" />
    </Border>
  </Grid>
</Window>