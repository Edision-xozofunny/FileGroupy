<Application x:Class="FileGroupy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
      <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F4F7FB" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#162033" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#667085" />
      <Style TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,10" />
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#182230" />
        <Setter Property="BorderBrush" Value="#CBD5E1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#344054" />
        <Setter Property="BorderBrush" Value="#CBD5E1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
      </Style>
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#344054" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="#E2E8F0" />
        <Style.Triggers>
          <Trigger Property="Orientation" Value="Vertical">
            <Setter Property="Width" Value="12" />
          </Trigger>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter Property="Height" Value="12" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style TargetType="Thumb">
        <Setter Property="Background" Value="#94A3B8" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>