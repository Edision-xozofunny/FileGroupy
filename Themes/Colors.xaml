<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 所有后续合并主题都会使用此字体资源, 必须定义在主题链最前端. -->
  <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
  <SolidColorBrush x:Key="AccentBrush" Color="#1677FF" />
  <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F6F8FC" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F2F4F7" />
  <SolidColorBrush x:Key="BorderBrush" Color="#DCE3EC" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF2FF" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#182230" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#667085" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#ECFDF3" />
  <SolidColorBrush x:Key="SuccessTextBrush" Color="#067647" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF7E8" />
  <SolidColorBrush x:Key="WarningBorderBrush" Color="#F4B740" />
  <SolidColorBrush x:Key="WarningTextBrush" Color="#9A6700" />
</ResourceDictionary>
