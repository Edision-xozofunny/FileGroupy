<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- 浮动分组行尺寸集中管理, 视图只引用资源避免与按钮主题脱节. -->
  <sys:Double x:Key="ExplorerStickyRowHeight">34</sys:Double>
  <sys:Double x:Key="ExplorerStickyPanelMinHeight">40</sys:Double>
  <Style TargetType="DataGrid">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#D0D5DD" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F6" />
    <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
    <Setter Property="RowBackground" Value="White" />
    <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
    <Setter Property="AlternationCount" Value="2" />
    <Setter Property="RowHeight" Value="42" />
    <Setter Property="ColumnHeaderHeight" Value="42" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="SelectionMode" Value="Extended" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#F8FAFC" />
    <Setter Property="Foreground" Value="#475467" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="BorderBrush" Value="#DCE3EC" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Foreground" Value="#344054" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAF2FF" /><Setter Property="Foreground" Value="#175CD3" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="DataGridRow">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F4F8FF" /></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAF2FF" /></Trigger>
      <DataTrigger Binding="{Binding File.IsInvalidImage}" Value="True"><Setter Property="Background" Value="#FFF1F0" /><Setter Property="Foreground" Value="#B42318" /></DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ExplorerTreeItemButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="56,5,5,5" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsCategory}" Value="True">
        <Setter Property="Padding" Value="8,7,5,7" />
        <Setter Property="Background" Value="#F8FAFC" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsExtensionGroup}" Value="True">
        <Setter Property="Padding" Value="32,6,5,6" />
        <Setter Property="Background" Value="#FCFDFE" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ExplorerTreeItemText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#344054" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsCategory}" Value="True">
        <Setter Property="FontWeight" Value="SemiBold" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsExtensionGroup}" Value="True">
        <Setter Property="Foreground" Value="#475467" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ExplorerRowIcon" TargetType="TextBlock">
    <Setter Property="Text" Value="&#xE8A5;" />
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Width" Value="24" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsCategory}" Value="True"><Setter Property="Text" Value="&#xE8B4;" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger>
      <DataTrigger Binding="{Binding IsExtensionGroup}" Value="True"><Setter Property="Text" Value="&#xE8B7;" /></DataTrigger>
      <DataTrigger Binding="{Binding File.IsInvalidImage}" Value="True"><Setter Property="Text" Value="&#xE7BA;" /><Setter Property="Foreground" Value="#B42318" /></DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ExplorerStickyPanelBorder" TargetType="Border">
    <Setter Property="Background" Value="#F8FAFC" />
    <Setter Property="BorderBrush" Value="#DCE3EC" />
    <Setter Property="BorderThickness" Value="1,0,1,0" />
    <Setter Property="MinHeight" Value="{StaticResource ExplorerStickyPanelMinHeight}" />
    <Setter Property="Padding" Value="0,3,0,3" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="ExplorerStickyItemButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="#EEF4FF" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Margin" Value="0,1,0,1" />
    <Setter Property="MinHeight" Value="{StaticResource ExplorerStickyRowHeight}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsExtensionGroup}" Value="True">
        <Setter Property="Background" Value="#F8FAFC" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ExplorerStickyItemText" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#344054" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsExtensionGroup}" Value="True">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="#475467" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ExplorerImageHoverPopupBorder" TargetType="Border">
    <Setter Property="Background" Value="#D9182230" />
    <Setter Property="BorderBrush" Value="#4CFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10" />
  </Style>
</ResourceDictionary>
