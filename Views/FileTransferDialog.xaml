<Window x:Class="FileGroupy.Views.FileTransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="{Binding Title}" Width="680" MaxHeight="760" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False" Background="{StaticResource PageBackgroundBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <ScrollViewer Style="{StaticResource AppScrollViewer}">
    <Grid Margin="32" MinWidth="580">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="36" Height="36" Background="{StaticResource AccentBrush}" CornerRadius="8" VerticalAlignment="Top">
                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding SelectionSummary}" Margin="0,7,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding SourceHint}" Margin="0,10,0,0" Foreground="#B54708" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <!-- 标题作为 Card 内容显式显示, 避免受 HandyControl 默认主题影响. -->
        <hc:Card Grid.Row="1" Style="{StaticResource AccentCard}" Margin="0,26,0,14">
            <StackPanel>
                <TextBlock Text="目标位置" FontFamily="{StaticResource AppFontFamily}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10" />
                <Border Style="{StaticResource CardContentPanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" Padding="11,9" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Command="{Binding ChooseDestinationCommand}" Content="本地文件夹" Background="#EAF2FF" Foreground="#175CD3" Margin="10,0,0,0" />
                    <Button Grid.Column="2" Command="{Binding ChooseMtpDestinationCommand}" Content="便携设备" Background="#F4EBFF" Foreground="#6941C6" Margin="8,0,0,0" />
                </Grid>
                </Border>
                <Border Style="{StaticResource CardContentPanel}" Margin="0,10,0,0" Padding="10,7">
                    <TextBlock Text="{Binding DestinationDescription}" Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </StackPanel>
        </hc:Card>
        <hc:Card Grid.Row="2" Style="{StaticResource AccentCard}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="目录与重名处理" FontFamily="{StaticResource AppFontFamily}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10" />
                <Border Style="{StaticResource CardContentPanel}">
                <StackPanel>
                <CheckBox Content="保持源路径目录结构" IsChecked="{Binding PreserveSourceStructure}" Margin="0,0,0,11" />
                <Separator Margin="0,0,0,11" Background="#EAECF0" />
                <TextBlock Text="遇到目标中已有同名文件时" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,0,8" />
                <WrapPanel>
                    <CheckBox Content="覆盖" IsChecked="{Binding OverwriteAll}" Margin="0,0,24,0" />
                    <CheckBox Content="跳过" IsChecked="{Binding SkipAllConflicts}" Margin="0,0,24,0" />
                    <CheckBox Content="重复文件重命名" IsChecked="{Binding RenameDuplicates}" IsEnabled="{Binding CanRenameDuplicates}" />
                </WrapPanel>
                <TextBlock Text="重命名示例：报告.pdf → 报告 (1).pdf，仅在不保留原目录结构时可用" Foreground="#98A2B3" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
                </Border>
            </StackPanel>
        </hc:Card>
        <Grid Grid.Row="3" Margin="0,2,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Height="20" Maximum="100" Value="{Binding ProgressPercent}" Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceMutedBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:0}%}" Width="54" Margin="12,0,0,0" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
            <hc:Badge Style="{StaticResource CountBadge}" Value="{Binding Failures.Count}" Maximum="999999" Margin="10,0,0,0" Visibility="{Binding HasFailures, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Command="{Binding ShowFailuresCommand}" Content="查看失败详情" Foreground="#B42318" Padding="8,2" />
            </hc:Badge>
        </Grid>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Command="{Binding CancelCommand}" Content="取消" Style="{StaticResource NeutralButton}" Margin="0,0,10,0" />
            <Button Command="{Binding StartCommand}" Content="开始" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>