<Window x:Class="FileGroupy.Views.MtpDevicePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择便携设备" Width="520" Height="360" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F6F8FC">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="选择便携设备" FontSize="22" FontWeight="SemiBold" Foreground="#182230" />
      <TextBlock Text="请选择“文件传输”(MTP) 或“照片传输”(PTP)；PTP 通常只提供相机媒体目录" Margin="0,7,0,18" Foreground="#667085" TextWrapping="Wrap" />
    </StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" BorderBrush="#D0D5DD" Background="White">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="12,8">
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#182230" />
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
              <TextBlock Text="{Binding Protocol}" Foreground="#175CD3" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text=" · " Foreground="#98A2B3" FontSize="12" />
              <TextBlock Text="{Binding Manufacturer}" Foreground="#667085" FontSize="12" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="取消" IsCancel="True" Background="#F2F4F7" Foreground="#344054" Margin="0,0,10,0" />
      <Button Content="扫描设备" IsDefault="True" Click="ScanButton_OnClick" Background="#1677FF" Foreground="White" />
    </StackPanel>
  </Grid>
</Window>