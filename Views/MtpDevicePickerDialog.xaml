<Window x:Class="FileGroupy.Views.MtpDevicePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="选择便携设备" Width="520" Height="360" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F6F8FC">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="选择便携设备" FontSize="22" FontWeight="SemiBold" Foreground="#182230" />
      <TextBlock Text="请选择“文件传输”(MTP) 或“照片传输”(PTP)；PTP 通常只提供相机媒体目录" Margin="0,7,0,18" Foreground="#667085" TextWrapping="Wrap" />
    </StackPanel>
    <hc:Card Grid.Row="1" Header="可用设备" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6">
      <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Padding="4">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Padding="10,8" Margin="0,2" CornerRadius="6">
            <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
              <TextBlock Text="{Binding Protocol}" Foreground="#175CD3" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text=" · " Foreground="#98A2B3" FontSize="12" />
              <TextBlock Text="{Binding Manufacturer}" Foreground="#667085" FontSize="12" />
            </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
      </ListBox>
    </hc:Card>
    <hc:Card Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,18,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" IsCancel="True" Style="{StaticResource NeutralButton}" Margin="0,0,10,0" />
      <Button Content="扫描设备" IsDefault="True" Click="ScanButton_OnClick" Style="{StaticResource PrimaryButton}" />
      </StackPanel>
    </hc:Card>
  </Grid>
</Window>