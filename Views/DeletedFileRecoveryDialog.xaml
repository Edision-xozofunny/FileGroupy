<Window x:Class="FileGroupy.Views.DeletedFileRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="删除找回" Width="1080" Height="680" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource PageBackgroundBrush}" FontFamily="{StaticResource AppFontFamily}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="36" Height="36" Background="{StaticResource AccentBrush}" CornerRadius="8" VerticalAlignment="Top">
                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="删除找回" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="本地文件删除后会暂存于恢复库。清除快照会永久删除对应文件。MTP/PTP 设备删除无法找回。" Margin="0,7,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,22,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="230" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" MinWidth="420" /></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="9,0" VerticalContentAlignment="Center" ToolTip="按时间、快照编号、文件名或原始路径搜索" />
                    <Button Grid.Column="1" Command="{Binding SearchCommand}" Content="&#xE721;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" ToolTip="搜索快照" />
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="选择左侧快照" Margin="8,3,8,8" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
                        <ListBox ItemsSource="{Binding VisibleSnapshots}" SelectedItem="{Binding SelectedSnapshot}" SelectionMode="Single" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding FileCount, StringFormat={}{0:N0} 个可恢复文件}" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding TotalSizeText}" Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" Background="Transparent" Cursor="SizeWE" ToolTip="拖动调整左右区域宽度" />
            <Grid Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Background="{StaticResource BorderBrush}">
                <Grid.RowDefinitions><RowDefinition Height="3" /><RowDefinition Height="3" /><RowDefinition Height="3" /><RowDefinition Height="3" /><RowDefinition Height="3" /></Grid.RowDefinitions>
                <Ellipse Grid.Row="0" Width="4" Height="4" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                <Ellipse Grid.Row="1" Width="4" Height="4" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                <Ellipse Grid.Row="2" Width="4" Height="4" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                <Ellipse Grid.Row="3" Width="4" Height="4" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                <Ellipse Grid.Row="4" Width="4" Height="4" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            </Grid>
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="选择要恢复的文件（支持多选）· 双击行查看详情" Margin="8,3,8,8" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
                    <DataGrid Grid.Row="1" x:Name="RecoveryFilesGrid" ItemsSource="{Binding Files}" SelectionChanged="RecoveryFilesGrid_OnSelectionChanged" MouseDoubleClick="RecoveryFilesGrid_OnMouseDoubleClick" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" BorderThickness="0" Background="Transparent" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="52">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate><CheckBox Click="SelectAllFilesCheckBox_OnClick" ToolTip="全选或取消选择当前快照中的文件" HorizontalAlignment="Center" /></DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="FileSelectionCheckBox_OnClick" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="选择此文件" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="文件" Width="180">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Item.FileName}" TextWrapping="Wrap" ToolTip="{Binding Item.FileName}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="原位置" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Item.OriginalPath}" TextWrapping="Wrap" ToolTip="{Binding Item.OriginalPath}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="大小" Binding="{Binding Item.SizeText}" Width="100" />
                        <DataGridTextColumn Header="删除前修改时间" Binding="{Binding Item.LastModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="160" />
                    </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <hc:Drawer x:Name="RecoveryDetailsDrawer" Grid.ColumnSpan="3" IsOpen="{Binding IsFileDetailsOpen, Mode=TwoWay}" Dock="Right" ShowMask="False" Width="360" MinWidth="360" MaxWidth="360" Panel.ZIndex="10">
                <hc:Card Header="文件详情" Width="360" Padding="18" Background="{StaticResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedFileDetail.FileName}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="原始位置" Margin="0,18,0,4" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding SelectedFileDetail.OriginalPath}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="130" />
                        <TextBlock Text="恢复库位置" Margin="0,14,0,4" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding SelectedFileDetail.RecoveryPath}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="100" />
                        <TextBlock Text="{Binding SelectedFileDetail.SizeText}" Margin="0,14,0,0" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding SelectedFileDetail.LastModified, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Margin="0,4,0,18" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Button Command="{Binding CloseFileDetailsCommand}" Content="关闭详情" Style="{StaticResource NeutralButton}" HorizontalAlignment="Right" />
                    </StackPanel>
                </hc:Card>
            </hc:Drawer>
        </Grid>
        <hc:Card Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0" GroupName="RestoreTarget" IsChecked="{Binding RestoreToOriginalPath, Mode=TwoWay}" Content="恢复至原路径" VerticalAlignment="Center" />
                <RadioButton Grid.Column="1" GroupName="RestoreTarget" IsChecked="{Binding RestoreToSpecifiedPath, Mode=TwoWay}" Content="恢复至指定目录" Margin="22,0,14,0" VerticalAlignment="Center" />
                <TextBox Grid.Column="2" Text="{Binding RestoreDestinationPath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding RestoreToSpecifiedPath}" Padding="9,6" VerticalContentAlignment="Center" />
                <Button Grid.Column="3" Command="{Binding ChooseRestoreDestinationCommand}" Content="浏览..." Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
            </Grid>
        </hc:Card>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Command="{Binding RestoreSelectedCommand}" Content="恢复选中文件" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
            <Button Grid.Column="2" Command="{Binding RestoreAllCommand}" Content="恢复当前快照全部文件" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
            <Button Grid.Column="3" Click="RecoveryHistoryButton_OnClick" Content="查看操作历史" Style="{StaticResource NeutralButton}" Margin="10,0,0,0" />
            <Button Grid.Column="4" x:Name="PermanentlyDeleteButton" Command="{Binding PermanentlyDeleteSnapshotCommand}" PreviewMouseLeftButtonDown="PermanentlyDeleteButton_OnPreviewMouseLeftButtonDown" Content="永久清除快照" Style="{StaticResource DangerButton}" Margin="10,0,0,0" />
        </Grid>
    </Grid>
</Window>