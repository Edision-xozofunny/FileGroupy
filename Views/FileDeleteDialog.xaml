<Window x:Class="FileGroupy.Views.FileDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="批量删除文件" Width="680" MaxHeight="760" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False" Background="{StaticResource PageBackgroundBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <ScrollViewer Style="{StaticResource AppScrollViewer}">
    <Grid Margin="32" MinWidth="580">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="36" Height="36" Background="#D92D20" CornerRadius="8" VerticalAlignment="Top">
                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="批量删除文件" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding SelectionSummary}" Margin="0,7,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding SourceHint}" Margin="0,10,0,0" Foreground="#B54708" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <!-- 标题作为 Card 内容显式显示, 删除说明使用警示语义色. -->
        <hc:Card Grid.Row="1" Style="{StaticResource WarningCard}" Margin="0,20,0,16">
            <StackPanel>
                <TextBlock Text="删除说明" FontFamily="{StaticResource AppFontFamily}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource WarningTextBrush}" Margin="0,0,0,10" />
                <Border Style="{StaticResource CardContentPanel}">
                    <TextBlock Text="将尝试删除所选中的全部文件再次点击“开始删除”时，已被移动或删除的文件会记录为失败，可在“查看失败详情”中查看" TextWrapping="Wrap" Foreground="#475467" />
                </Border>
            </StackPanel>
        </hc:Card>
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <Border Background="#ECFDF3" BorderBrush="#12B76A" BorderThickness="1" CornerRadius="8" Padding="12" Visibility="{Binding HasRecoveryCapacityAssessment, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="删除找回容量预估" Foreground="#067647" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RecoveryCapacityText}" Foreground="#067647" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Background="#FFF1F0" BorderBrush="#D92D20" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                <StackPanel>
                    <CheckBox IsChecked="{Binding HasConfirmedSourceDeletion}" Foreground="#B42318" FontWeight="SemiBold">
                        <TextBlock Text="我确认删除源文件，并已了解本地文件可通过“删除找回”恢复，设备文件可能无法恢复" TextWrapping="Wrap" />
                    </CheckBox>
                    <CheckBox IsChecked="{Binding PermanentlyDeleteLocalFiles}" Foreground="#B42318" FontWeight="SemiBold" Margin="0,10,0,0">
                        <TextBlock Text="永久删除本地源文件，不创建删除找回快照（不可恢复）" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Text="恢复库空间不足时，只有勾选永久删除才能继续。" Foreground="#B42318" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding IsRecoverySpaceInsufficient, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,2,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ProgressBar Height="20" Maximum="100" Value="{Binding ProgressPercent}" Foreground="#D92D20" Background="{StaticResource SurfaceMutedBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:0}%}" Width="54" Margin="12,0,0,0" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
            <hc:Badge Style="{StaticResource CountBadge}" Value="{Binding Failures.Count}" Maximum="999999" Margin="10,0,0,0" Visibility="{Binding HasFailures, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Command="{Binding ShowFailuresCommand}" Content="查看失败详情" Foreground="#B42318" Padding="8,2" />
            </hc:Badge>
        </Grid>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Command="{Binding CancelCommand}" Content="取消" Style="{StaticResource NeutralButton}" Margin="0,0,10,0" />
            <Button Command="{Binding StartDeleteCommand}" Content="开始删除" Style="{StaticResource DangerButton}" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
