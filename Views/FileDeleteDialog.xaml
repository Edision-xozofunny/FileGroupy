<Window x:Class="FileGroupy.Views.FileDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量删除文件" Width="680" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="True" Background="#F6F8FC">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="批量删除文件" FontSize="25" FontWeight="SemiBold" Foreground="#182230" />
            <TextBlock Text="{Binding SelectionSummary}" Margin="0,7,0,0" Foreground="#667085" />
            <TextBlock Text="{Binding SourceHint}" Margin="0,10,0,0" Foreground="#B54708" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,20,0,16">
            <TextBlock Text="将尝试删除所选中的全部文件再次点击“开始删除”时，已被移动或删除的文件会记录为失败，可在“查看失败详情”中查看" TextWrapping="Wrap" Foreground="#475467" />
        </Border>
        <ProgressBar Grid.Row="2" Height="12" Maximum="100" Value="{Binding ProgressPercent}" Margin="0,2,0,10" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="#667085" FontSize="12" VerticalAlignment="Center" />
            <Button Command="{Binding ShowFailuresCommand}" Content="查看失败详情" Foreground="#B42318" Padding="8,2" Margin="10,0,0,0" Visibility="{Binding HasFailures, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Command="{Binding CancelCommand}" Content="取消" Background="#F2F4F7" Foreground="#344054" Margin="0,0,10,0" />
            <Button Command="{Binding StartDeleteCommand}" Content="开始删除" Background="#D92D20" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
