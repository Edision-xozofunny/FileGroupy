<Window x:Class="FileGroupy.Views.FileTransferFailuresDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="传输失败详情" Width="1040" Height="620" MinWidth="760" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource PageBackgroundBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Width="36" Height="36" Background="#D92D20" CornerRadius="8" VerticalAlignment="Top">
        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1">
        <TextBlock Text="传输失败详情" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock Text="仅保留本次复制或移动任务中的失败记录" Margin="0,7,0,20" Foreground="{StaticResource TextSecondaryBrush}" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
    <DataGrid ItemsSource="{Binding Failures}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" BorderThickness="0" Background="Transparent" FrozenColumnCount="2"
        hc:DataGridAttach.ShowRowNumber="True"
          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="160" />
        <DataGridTextColumn Header="来源" Binding="{Binding SourceKind}" Width="90" />
        <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="100" />
        <DataGridTextColumn Header="源路径" Binding="{Binding SourcePath}" Width="360" />
        <DataGridTextColumn Header="目标路径" Binding="{Binding DestinationPath}" Width="360" />
        <DataGridTextColumn Header="失败原因" Binding="{Binding Reason}" Width="420" />
      </DataGrid.Columns>
    </DataGrid>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="导出 CSV" Click="ExportCsvButton_OnClick" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
      <Button Content="关闭" IsCancel="True" Style="{StaticResource PrimaryButton}" />
    </StackPanel>
  </Grid>
</Window>