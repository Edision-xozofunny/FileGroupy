<UserControl x:Class="FileGroupy.Views.FileExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FileGroupy.Controls"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="48,42,48,48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Subtitle}" Margin="0,7,0,28" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Command="{Binding ClearSelectionCommand}" Content="取消全选" Style="{StaticResource NeutralButton}" Padding="16,7" />
            <TextBlock Grid.Column="1" Text="树形层级" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="20,0,10,0" />
            <TextBox x:Name="SearchBox" Grid.Column="2" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,10,0" VerticalContentAlignment="Center" ToolTip="按 Ctrl+F 搜索文件" />
            <Button Grid.Column="3" Click="SearchButton_OnClick" Content="搜索" Style="{StaticResource SecondaryButton}" Padding="16,7" />
            <ComboBox Grid.Column="4" ItemsSource="{Binding ExpansionLevels}" SelectedItem="{Binding SelectedExpansionLevel}" Width="78" Height="32" Margin="10,0,10,0" VerticalContentAlignment="Center" />
            <Button Grid.Column="5" Command="{Binding ExpandToLevelCommand}" Content="展开" Style="{StaticResource SecondaryButton}" Padding="16,7" />
            <Button Grid.Column="6" Command="{Binding CollapseAllCommand}" Content="收缩" Style="{StaticResource NeutralButton}" Padding="16,7" Margin="8,0,0,0" />
            <Button Grid.Column="7" Command="{Binding RefreshCurrentCommand}" Content="刷新" Style="{StaticResource SecondaryButton}" Padding="16,7" Margin="8,0,0,0" />
            <Button Grid.Column="8" Command="{Binding ToggleInvalidImagesFilterCommand}" Content="无效图像" Style="{StaticResource NeutralButton}" Padding="16,7" Margin="8,0,0,0" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ExplorerStickyPanelBorder}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StickyItems.Count, ElementName=FilesGrid}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StickyItems.Count, ElementName=FilesGrid}" Value="2">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ItemsControl ItemsSource="{Binding StickyItems, ElementName=FilesGrid}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}" Click="FileCheckBox_OnClick" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ExplorerStickyItemButton}"
                                        Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource ExplorerStickyItemText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0,4,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="#667085" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Grid Grid.Row="1">
                <controls:StickyDataGrid x:Name="FilesGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E2E8F0" BorderThickness="1" Background="{StaticResource SurfaceBrush}" RowHeaderWidth="0" FrozenColumnCount="2"
                    hc:DataGridAttach.ShowRowNumber="True" hc:DataGridAttach.ShowSelectAllButton="True"
                    SelectionMode="Extended" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                    ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    PreviewMouseLeftButtonDown="FilesGrid_OnPreviewMouseLeftButtonDown" PreviewMouseMove="FilesGrid_OnPreviewMouseMove" PreviewMouseLeftButtonUp="FilesGrid_OnPreviewMouseLeftButtonUp"
                    MouseMove="FilesGrid_OnMouseMove" MouseLeave="FilesGrid_OnMouseLeave"
                    MouseDoubleClick="FilesGrid_OnMouseDoubleClick" ContextMenuOpening="FilesGrid_OnContextMenuOpening">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="OpenMenuItem" Header="打开" Visibility="Collapsed" Click="OpenMenuItem_OnClick" />
                            <MenuItem x:Name="OpenWithMenuItem" Header="打开方式" Visibility="Collapsed" Click="OpenWithMenuItem_OnClick" />
                            <MenuItem x:Name="OpenLocationMenuItem" Header="打开文件位置" Visibility="Collapsed" Click="OpenLocationMenuItem_OnClick" />
                            <Separator x:Name="OpenMenuSeparator" Visibility="Collapsed" />
                            <MenuItem Header="复制到..." Command="{Binding PlacementTarget.DataContext.CopySelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="移动到..." Command="{Binding PlacementTarget.DataContext.MoveSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem x:Name="DeleteMenuItem" Header="删除..." Command="{Binding PlacementTarget.DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          Click="SelectAllCheckBox_OnClick" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsSelectable}"
                            Click="FileCheckBox_OnClick" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="名称" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ExplorerTreeItemButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ExplorerTreeItemText}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplayName}" Width="155" />
                        <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="110" />
                        <DataGridTextColumn Header="修改时间" Binding="{Binding Modified}" Width="150" />
                        <DataGridTextColumn Header="位置" Binding="{Binding Location}" Width="3*" />
                    </DataGrid.Columns>
                </controls:StickyDataGrid>
                <Border x:Name="SelectionBox" Visibility="Collapsed" BorderBrush="#1677FF" BorderThickness="1" Background="#261677FF" IsHitTestVisible="False" />
                <TextBlock Text="{Binding OperationStatus}" Foreground="{StaticResource SuccessTextBrush}" Background="{StaticResource SuccessSoftBrush}" Margin="12" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="{Binding HasOperationStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Popup x:Name="ImageHoverPopup" Placement="Relative" StaysOpen="True" AllowsTransparency="True" IsHitTestVisible="False" IsOpen="False">
                    <Border Style="{StaticResource ExplorerImageHoverPopupBorder}" Width="300">
                        <Grid>
                            <Image x:Name="ImageHoverPreviewImage" Height="180" Stretch="Uniform" />
                            <Border Background="#66000000" CornerRadius="6" Padding="8" VerticalAlignment="Bottom" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="ImageHoverResolutionText" Foreground="#F9FAFB" FontSize="12" />
                                    <TextBlock x:Name="ImageHoverSizeText" Foreground="#F9FAFB" FontSize="12" />
                                    <TextBlock x:Name="ImageHoverTypeText" Foreground="#F9FAFB" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="ImageHoverCorruptedText" Text="该图像已损坏" Foreground="#FECACA" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
