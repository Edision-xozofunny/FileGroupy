<UserControl x:Class="FileGroupy.Views.FileExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FileGroupy.Controls">
    <Grid Margin="48,42,48,48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Subtitle}" Margin="0,7,0,28" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="树形层级" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
            <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,10,0" VerticalContentAlignment="Center" ToolTip="按 Ctrl+F 搜索文件" />
            <Button Grid.Column="2" Click="SearchButton_OnClick" Content="搜索" Style="{StaticResource SecondaryButton}" Padding="16,7" />
            <ComboBox Grid.Column="3" ItemsSource="{Binding ExpansionLevels}" SelectedItem="{Binding SelectedExpansionLevel}" Width="78" Height="32" Margin="10,0,10,0" VerticalContentAlignment="Center" />
            <Button Grid.Column="4" Command="{Binding ExpandToLevelCommand}" Content="展开" Style="{StaticResource SecondaryButton}" Padding="16,7" />
            <Button Grid.Column="5" Command="{Binding CollapseAllCommand}" Content="收缩" Style="{StaticResource NeutralButton}" Padding="16,7" Margin="8,0,0,0" />
        </Grid>
        <Grid Grid.Row="2">
            <controls:StickyDataGrid x:Name="FilesGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E2E8F0" BorderThickness="1" Background="{StaticResource SurfaceBrush}" RowHeaderWidth="0" FrozenColumnCount="2"
                SelectionMode="Extended" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                PreviewMouseLeftButtonDown="FilesGrid_OnPreviewMouseLeftButtonDown" PreviewMouseMove="FilesGrid_OnPreviewMouseMove" PreviewMouseLeftButtonUp="FilesGrid_OnPreviewMouseLeftButtonUp"
                MouseDoubleClick="FilesGrid_OnMouseDoubleClick" ContextMenuOpening="FilesGrid_OnContextMenuOpening">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC" />
                        <Setter Property="Foreground" Value="#475467" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="10,11" />
                        <Setter Property="BorderBrush" Value="#E2E8F0" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="MinHeight" Value="38" />
                        <Setter Property="BorderBrush" Value="#F2F4F7" />
                        <Setter Property="Background" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DCEBFF" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="OpenMenuItem" Header="打开" Visibility="Collapsed" Click="OpenMenuItem_OnClick" />
                        <MenuItem x:Name="OpenWithMenuItem" Header="打开方式" Visibility="Collapsed" Click="OpenWithMenuItem_OnClick" />
                        <MenuItem x:Name="OpenLocationMenuItem" Header="打开文件位置" Visibility="Collapsed" Click="OpenLocationMenuItem_OnClick" />
                        <Separator x:Name="OpenMenuSeparator" Visibility="Collapsed" />
                        <MenuItem Header="复制到..." Command="{Binding PlacementTarget.DataContext.CopySelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="移动到..." Command="{Binding PlacementTarget.DataContext.MoveSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.Header>
                            <CheckBox IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      Click="SelectAllCheckBox_OnClick" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsSelectable}"
                        Click="FileCheckBox_OnClick" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="名称" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="4" HorizontalContentAlignment="Left">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Padding" Value="30,5,5,5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                                    <Setter Property="Padding" Value="8,7,5,7" />
                                                    <Setter Property="Background" Value="#F8FAFC" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="#344054">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplayName}" Width="155" />
                    <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="110" />
                    <DataGridTextColumn Header="修改时间" Binding="{Binding Modified}" Width="150" />
                    <DataGridTextColumn Header="位置" Binding="{Binding Location}" Width="3*" />
                </DataGrid.Columns>
            </controls:StickyDataGrid>
                        <Border Panel.ZIndex="100" Background="#F1F5F9" BorderBrush="#DCE3EC" BorderThickness="0,0,0,1" Height="38" Margin="0,40,12,0" VerticalAlignment="Top"
                            DataContext="{Binding StickyItem, ElementName=FilesGrid}" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="#344054" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Size}" Foreground="#667085" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border x:Name="SelectionBox" Visibility="Collapsed" BorderBrush="#1677FF" BorderThickness="1" Background="#261677FF" IsHitTestVisible="False" />
        </Grid>
    </Grid>
</UserControl>