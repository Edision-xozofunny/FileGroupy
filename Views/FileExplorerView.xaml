<UserControl x:Class="FileGroupy.Views.FileExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FileGroupy.Controls"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid x:Name="ExplorerRoot" Margin="48,42,48,48" Loaded="ExplorerRoot_OnLoaded" Unloaded="ExplorerRoot_OnUnloaded" SizeChanged="ExplorerRoot_OnSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="54" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Subtitle}" Margin="0,7,0,28" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Command="{Binding ClearSelectionCommand}" Content="取消全选" Style="{StaticResource NeutralButton}" Padding="16,7" />
            <TextBlock Grid.Column="1" Text="树形层级" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="20,0,10,0" />
            <Grid Grid.Column="2" Height="34" Margin="0,0,10,0">
                <hc:SearchBar x:Name="SearchBox" Style="{StaticResource ExplorerSearchBar}" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" IsRealTime="True" Padding="10,0,34,0" VerticalContentAlignment="Center" ToolTip="按 Ctrl+F 搜索文件名，支持空格分词和缩写匹配" />
                <Button Command="{Binding ClearSearchCommand}" Style="{StaticResource SearchClearButton}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="清空搜索">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
            <TextBlock Grid.Column="3" Text="{Binding SearchResultText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox Grid.Column="4" ItemsSource="{Binding ExpansionLevels}" SelectedItem="{Binding SelectedExpansionLevel}" Width="78" Height="32" Margin="10,0,10,0" VerticalContentAlignment="Center" />
            <Button Grid.Column="5" Command="{Binding ExpandToLevelCommand}" Content="展开" Style="{StaticResource SecondaryButton}" Padding="16,7" />
            <Button Grid.Column="6" Command="{Binding CollapseAllCommand}" Content="收缩" Style="{StaticResource NeutralButton}" Padding="16,7" Margin="8,0,0,0" />
            <Button Grid.Column="7" Command="{Binding RefreshCurrentCommand}" Content="刷新" Style="{StaticResource SecondaryButton}" Padding="16,7" Margin="8,0,0,0" />
            <!-- 首次点击在后台校验, 校验完成后显示包含 0 在内的精确数量. -->
            <hc:Badge Grid.Column="8" Style="{StaticResource CountBadge}" Value="{Binding InvalidImageCount}" Maximum="999999" ShowBadge="{Binding HasInvalidImageValidation}" Margin="8,0,0,0" VerticalAlignment="Center">
                <ToggleButton Command="{Binding ToggleInvalidImagesFilterCommand}" IsChecked="{Binding IsInvalidImagesFilterActive, Mode=OneWay}" Content="{Binding InvalidImageFilterText}" Style="{StaticResource FilterToggleSwitch}" />
            </hc:Badge>
        </Grid>
        <Grid x:Name="ExplorerDataArea" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ExplorerStickyPanelBorder}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StickyItems.Count, ElementName=FilesGrid}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StickyItems.Count, ElementName=FilesGrid}" Value="2">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ItemsControl ItemsSource="{Binding StickyItems, ElementName=FilesGrid}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}" Click="FileCheckBox_OnClick" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ExplorerStickyItemButton}"
                                        Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource ExplorerStickyItemText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0,4,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="#667085" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Grid Grid.Row="1">
                <controls:StickyDataGrid x:Name="FilesGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E2E8F0" BorderThickness="1" Background="{StaticResource SurfaceBrush}" RowHeaderWidth="0" FrozenColumnCount="2"
                    hc:DataGridAttach.ShowRowNumber="True" hc:DataGridAttach.ShowSelectAllButton="True"
                    SelectionMode="Extended" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                    ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    PreviewMouseLeftButtonDown="FilesGrid_OnPreviewMouseLeftButtonDown" PreviewMouseMove="FilesGrid_OnPreviewMouseMove" PreviewMouseLeftButtonUp="FilesGrid_OnPreviewMouseLeftButtonUp"
                    MouseMove="FilesGrid_OnMouseMove" MouseLeave="FilesGrid_OnMouseLeave"
                    MouseDoubleClick="FilesGrid_OnMouseDoubleClick" ContextMenuOpening="FilesGrid_OnContextMenuOpening">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="DetailsMenuItem" Header="文件详情" Visibility="Collapsed" Click="DetailsMenuItem_OnClick" />
                            <Separator x:Name="DetailsMenuSeparator" Visibility="Collapsed" />
                            <MenuItem x:Name="OpenMenuItem" Header="打开" Visibility="Collapsed" Click="OpenMenuItem_OnClick" />
                            <MenuItem x:Name="OpenWithMenuItem" Header="打开方式" Visibility="Collapsed" Click="OpenWithMenuItem_OnClick" />
                            <MenuItem x:Name="OpenLocationMenuItem" Header="打开文件位置" Visibility="Collapsed" Click="OpenLocationMenuItem_OnClick" />
                            <Separator x:Name="OpenMenuSeparator" Visibility="Collapsed" />
                            <MenuItem Header="复制到..." Command="{Binding PlacementTarget.DataContext.CopySelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="移动到..." Command="{Binding PlacementTarget.DataContext.MoveSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem x:Name="DeleteMenuItem" Header="删除..." Command="{Binding PlacementTarget.DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          Click="SelectAllCheckBox_OnClick" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsSelectable}"
                            Click="FileCheckBox_OnClick" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="名称" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ExplorerTreeItemButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource ExplorerRowIcon}" />
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ExplorerTreeItemText}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplayName}" Width="155" />
                        <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="110" />
                        <DataGridTextColumn Header="修改时间" Binding="{Binding Modified}" Width="150" />
                        <DataGridTextColumn Header="位置" Binding="{Binding Location}" Width="3*" />
                    </DataGrid.Columns>
                </controls:StickyDataGrid>
                <Border x:Name="SelectionBox" Visibility="Collapsed" BorderBrush="#1677FF" BorderThickness="1" Background="#261677FF" IsHitTestVisible="False" />
                <TextBlock Text="{Binding OperationStatus}" Foreground="{StaticResource SuccessTextBrush}" Background="{StaticResource SuccessSoftBrush}" Margin="12" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="{Binding HasOperationStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Popup x:Name="ImageHoverPopup" Placement="Relative" StaysOpen="True" AllowsTransparency="True" IsHitTestVisible="False" IsOpen="False">
                    <Border Style="{StaticResource ExplorerImageHoverPopupBorder}" Width="300">
                        <Grid>
                            <Image x:Name="ImageHoverPreviewImage" Height="180" Stretch="Uniform" />
                            <Border Background="#66000000" CornerRadius="6" Padding="8" VerticalAlignment="Bottom" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="ImageHoverResolutionText" Foreground="#F9FAFB" FontSize="12" />
                                    <TextBlock x:Name="ImageHoverSizeText" Foreground="#F9FAFB" FontSize="12" />
                                    <TextBlock x:Name="ImageHoverTypeText" Foreground="#F9FAFB" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="ImageHoverCorruptedText" Text="该图像已损坏" Foreground="#FECACA" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Popup>
                <!-- 树行在后台重建期间显示局部遮罩, 防止用户重复触发操作. -->
                <Border Background="#B3FFFFFF" Visibility="{Binding IsTreeOperationInProgress, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="20">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="220">
                        <ProgressBar Height="6" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="{StaticResource AccentSoftBrush}" />
                        <TextBlock Text="正在更新文件列表..." Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <!-- 刷新遮罩与 Dashboard 共用同一阶段标题和动态进度文本. -->
                <Border Background="#B8F6F8FC" Visibility="{Binding IsRefreshOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="25">
                    <hc:Card Width="360" Padding="20" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding RefreshStageTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                            <ProgressBar Height="6" IsIndeterminate="True" Margin="0,14,0,12" Foreground="{StaticResource AccentBrush}" Background="{StaticResource AccentSoftBrush}" />
                            <TextBlock Text="{Binding RefreshProgressText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </hc:Card>
                </Border>
                <!-- 文件详情只从右键菜单打开, 点击表格其他位置时由代码隐藏层关闭. -->
                <hc:Drawer x:Name="DetailsDrawer" IsOpen="{Binding IsDetailsDrawerOpen, Mode=TwoWay}" Dock="Right" ShowMask="False" Width="280" MinWidth="280" MaxWidth="280" Panel.ZIndex="30">
                    <hc:Card Header="文件详情" Width="280" Margin="0" Padding="18" Background="{StaticResource SurfaceBrush}">
                        <Grid Width="244" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox Text="{Binding SelectedRow.Name, Mode=OneWay}" Width="244" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Background="Transparent" BorderThickness="0" Padding="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" />
                            <TextBox Grid.Row="1" Text="{Binding SelectedRow.TypeDisplayName, Mode=OneWay}" Width="244" Margin="0,8,0,18" Foreground="{StaticResource AccentBrush}" Background="Transparent" BorderThickness="0" Padding="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="大小" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                            <TextBox Grid.Row="3" Text="{Binding SelectedRow.Size, Mode=OneWay}" Width="244" Margin="0,3,0,14" Foreground="{StaticResource TextPrimaryBrush}" Background="Transparent" BorderThickness="0" Padding="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" />
                            <StackPanel Grid.Row="4" Orientation="Horizontal">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="修改时间" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Row="5" Margin="0,3,0,14">
                                <TextBox Text="{Binding SelectedRow.Modified, Mode=OneWay}" Width="244" Foreground="{StaticResource TextPrimaryBrush}" Background="Transparent" BorderThickness="0" Padding="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,3">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="位置" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <TextBox Text="{Binding SelectedRow.Location, Mode=OneWay}" Width="244" Foreground="{StaticResource TextPrimaryBrush}" Background="Transparent" BorderThickness="0" Padding="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" />
                                </ScrollViewer>
                            </StackPanel>
                            <Button Grid.Row="6" Command="{Binding CloseDetailsCommand}" Content="关闭详情" Style="{StaticResource NeutralButton}" HorizontalAlignment="Right" />
                        </Grid>
                    </hc:Card>
                </hc:Drawer>
            </Grid>
        </Grid>
        <hc:Card x:Name="FloatingBackToTop" Grid.RowSpan="4" Panel.ZIndex="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Padding="0"
                 Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Cursor="SizeAll"
                 PreviewMouseLeftButtonDown="FloatingBackToTop_OnMouseLeftButtonDown" PreviewMouseMove="FloatingBackToTop_OnMouseMove" PreviewMouseLeftButtonUp="FloatingBackToTop_OnMouseLeftButtonUp"
                 ToolTip="单击回到顶部，按住可拖动">
            <hc:Card.RenderTransform><TranslateTransform x:Name="BackToTopTransform" /></hc:Card.RenderTransform>
            <Button Width="34" Height="34" Padding="0" Style="{StaticResource PrimaryButton}" IsHitTestVisible="False">
                <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
        </hc:Card>
    </Grid>
</UserControl>
