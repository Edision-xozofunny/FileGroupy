<Window x:Class="FileGroupy.Views.MtpFolderPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:FileGroupy.ViewModels"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="选择设备文件夹" Width="620" Height="560" WindowStartupLocation="CenterOwner" Background="#F6F8FC"
        Loaded="Window_OnLoaded">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <HierarchicalDataTemplate DataType="{x:Type viewModels:MtpFolderNode}" ItemsSource="{Binding Children}">
      <StackPanel Margin="2,4">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Text="{Binding Name}" Foreground="#182230" />
        <TextBlock Text="{Binding LoadError}" Foreground="#D92D20" FontSize="11" />
      </StackPanel>
    </HierarchicalDataTemplate>
    <Style TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
          <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="选择设备中的文件夹" FontSize="22" FontWeight="SemiBold" Foreground="#182230" />
      <TextBlock Text="MTP 会显示共享存储目录；PTP 通常只显示相机媒体目录展开节点可继续读取子文件夹" Margin="0,7,0,18" Foreground="#667085" TextWrapping="Wrap" />
    </StackPanel>
    <Grid Grid.Row="1">
      <hc:Card Header="设备目录" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6">
        <TreeView x:Name="FolderTree" ItemsSource="{Binding RootNodes}" SelectedItemChanged="FolderTree_OnSelectedItemChanged" TreeViewItem.Expanded="FolderTree_OnExpanded"
            BorderThickness="0" Background="Transparent" Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </hc:Card>
      <TextBlock Text="正在读取手机文件夹..." Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                 Background="#CCFFFFFF" Foreground="#175CD3" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,10" />
    </Grid>
    <hc:Card Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,18,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <TextBlock Text="{Binding SelectedPath}" Foreground="#667085" Width="320" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,14,0" />
      <Button Content="取消" IsCancel="True" Style="{StaticResource NeutralButton}" Margin="0,0,10,0" />
      <Button Content="从此文件夹扫描" IsDefault="True" Click="ScanButton_OnClick" Style="{StaticResource PrimaryButton}" />
      </StackPanel>
    </hc:Card>
  </Grid>
</Window>