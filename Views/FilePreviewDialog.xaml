<Window x:Class="FileGroupy.Views.FilePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="{Binding Title}" Width="960" Height="680" MinWidth="640" MinHeight="460" WindowStartupLocation="CenterOwner" Background="{StaticResource PageBackgroundBrush}" FontFamily="{StaticResource AppFontFamily}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Foreground="#182230" TextTrimming="CharacterEllipsis" />
      <TextBox Text="{Binding File.FullPath}" Margin="0,5,0,0" Foreground="#667085" Background="Transparent" BorderThickness="0"
               IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="72"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ToolTip="可选择并复制完整文件位置" />
      <TextBlock Text="{Binding Notice}" Margin="0,7,0,0" Foreground="#B54708" />
    </StackPanel>
    <hc:Card Grid.Row="1" Header="预览" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="0" Margin="0,18,0,18">
      <Grid>
        <TextBox Text="{Binding TextContent}" Visibility="{Binding IsTextPreview, Converter={StaticResource BooleanToVisibilityConverter}}" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="14" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="14" BorderThickness="0" />
        <ScrollViewer Style="{StaticResource AppScrollViewer}" Visibility="{Binding IsImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Border Background="{StaticResource SurfaceMutedBrush}" Padding="12">
            <Image Source="{Binding ImageSource}" Stretch="Uniform" />
          </Border>
        </ScrollViewer>
      </Grid>
    </hc:Card>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Command="{Binding OpenWithDefaultApplicationCommand}" Content="使用默认程序打开" Background="#EAF2FF" Foreground="#175CD3" Margin="0,0,10,0" />
      <Button Content="关闭" IsCancel="True" Background="#1677FF" Foreground="White" />
    </StackPanel>
  </Grid>
</Window>