<Window x:Class="FileGroupy.Views.RecoveryHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="删除恢复操作历史" Width="980" Height="560" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource PageBackgroundBrush}" FontFamily="{StaticResource AppFontFamily}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="删除恢复操作历史" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="以下记录独立保存在 SQLite 中，即使快照已全部恢复或永久清除，也不会随快照删除。" Margin="0,6,0,16" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="快照创建记录">
                <DataGrid ItemsSource="{Binding CreationHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,8" RowHeaderWidth="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="180" />
                        <DataGridTextColumn Header="快照 ID" Binding="{Binding SnapshotId}" Width="*" />
                        <DataGridTextColumn Header="文件数" Binding="{Binding FileCount}" Width="100" />
                        <DataGridTextColumn Header="总大小" Binding="{Binding TotalSizeText}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="恢复记录">
                <DataGrid ItemsSource="{Binding RestoreHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,8" RowHeaderWidth="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="恢复时间" Binding="{Binding RestoredAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="180" />
                        <DataGridTextColumn Header="快照 ID" Binding="{Binding SnapshotId}" Width="*" />
                        <DataGridTextColumn Header="请求文件数" Binding="{Binding RequestedFileCount}" Width="100" />
                        <DataGridTextColumn Header="成功文件数" Binding="{Binding SucceededFileCount}" Width="100" />
                        <DataGridTextColumn Header="恢复大小" Binding="{Binding RestoredSizeText}" Width="150" />
                        <DataGridTextColumn Header="失败数" Binding="{Binding FailureCount}" Width="80" />
                        <DataGridCheckBoxColumn Header="恢复全部" Binding="{Binding RestoreAll}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <Button Grid.Row="2" Content="关闭" Style="{StaticResource NeutralButton}" HorizontalAlignment="Right" Margin="0,14,0,0" IsCancel="True" />
    </Grid>
</Window>