<UserControl x:Class="FileGroupy.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style x:Key="CategoryCardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,14,14" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="48,42,48,48">
      <TextBlock Text="文件概览" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
      <TextBlock Text="扫描存储空间，整理每一种文件类型" Margin="0,7,0,28" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" />

      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="26">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="扫描来源" Foreground="#667085" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedPath}" FontSize="16" Margin="0,5,0,0" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding FolderInfo}" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding ErrorMessage}" Margin="0,8,0,0" Foreground="#D92D20" />
          </StackPanel>
          <Button Grid.Column="1" Command="{Binding ChooseMtpDeviceCommand}" Background="#EAF2FF" Foreground="#1D4ED8" Padding="18,11" Margin="18,0,0,0">
            <TextBlock Text="选择便携设备" FontWeight="SemiBold" />
          </Button>
          <Button Grid.Column="2" Command="{Binding ChooseFolderCommand}" Background="#2563EB" Foreground="White" Padding="18,11" Margin="10,0,0,0">
            <TextBlock Text="选择文件夹" FontWeight="SemiBold" />
          </Button>
        </Grid>
      </Border>

      <Border Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#EFF8FF" BorderBrush="#B2DDFF" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,16,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="正在扫描文件" FontWeight="SemiBold" Foreground="#175CD3" />
            <ProgressBar IsIndeterminate="True" Height="6" Margin="0,11,0,9" Foreground="#1677FF" Background="#D1E9FF" />
            <TextBlock Text="{Binding ScanProgressText}" Foreground="#475467" />
          </StackPanel>
          <Button Grid.Column="1" Command="{Binding CancelScanCommand}" Content="取消扫描" Background="#D92D20" Foreground="White" Margin="18,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Grid Margin="0,32,0,12">
        <TextBlock Text="文件分类" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock Text="选择一个分类查看明细" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Categories}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource CategoryCardButton}" Command="{Binding DataContext.OpenCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Category}">
              <Border Width="210" Height="136" Background="{StaticResource SurfaceBrush}" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="17">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Width="42" Height="36" Background="#EEF4FF" CornerRadius="7"><TextBlock Text="{Binding Icon}" Foreground="#2563EB" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <StackPanel Grid.Column="1" Margin="11,0,0,0"><TextBlock Text="{Binding Name}" Foreground="#344054" FontWeight="SemiBold" /><TextBlock Text="{Binding FileCount, StringFormat={}{0:N0} 个文件}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,7,0,0" /></StackPanel>
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SizeText}" Foreground="#98A2B3" VerticalAlignment="Bottom" />
                </Grid>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>