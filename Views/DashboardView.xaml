<UserControl x:Class="FileGroupy.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style x:Key="CategoryCardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid Margin="48,42,48,48">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="文件概览" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
      <TextBlock Text="扫描存储空间，整理每一种文件类型" Margin="0,7,0,28" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" />

      <!-- Header 属性在当前 HandyControl 主题中不渲染, 标题作为 Card 内容显式显示. -->
      <hc:Card Style="{StaticResource AccentCard}" Padding="20">
        <StackPanel>
          <TextBlock Text="扫描来源" FontFamily="{StaticResource AppFontFamily}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10" />
          <Border Style="{StaticResource CardContentPanel}">
          <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding SelectedPath}" FontSize="16" Margin="0,5,0,0" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding FolderInfo}" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding ErrorMessage}" Margin="0,8,0,0" Foreground="#D92D20" />
          </StackPanel>
          <Button Grid.Column="1" Command="{Binding OpenDeletedFileRecoveryCommand}" Content="删除找回" Style="{StaticResource NeutralButton}" Padding="18,11" Margin="18,0,0,0" />
          <Button Grid.Column="2" Command="{Binding RefreshCurrentCommand}" Content="刷新" Style="{StaticResource NeutralButton}" Padding="18,11" Margin="10,0,0,0" />
          <Button Grid.Column="3" Command="{Binding ChooseMtpDeviceCommand}" Style="{StaticResource SecondaryButton}" Padding="18,11" Margin="10,0,0,0">
            <TextBlock Text="选择便携设备" FontWeight="SemiBold" />
          </Button>
          <Button Grid.Column="4" Command="{Binding ChooseFolderCommand}" Style="{StaticResource PrimaryButton}" Padding="18,11" Margin="10,0,0,0">
            <TextBlock Text="选择文件夹" FontWeight="SemiBold" />
          </Button>
          </Grid>
          </Border>
        </StackPanel>
      </hc:Card>

      <Border Visibility="{Binding IsScanProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,16,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding ScanStageTitle}" FontWeight="SemiBold" Foreground="#175CD3" />
            <ProgressBar IsIndeterminate="True" Height="6" Margin="0,11,0,9" Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceMutedBrush}" />
            <TextBlock Text="{Binding ScanProgressText}" Foreground="#475467" />
          </StackPanel>
          <Button Grid.Column="1" Command="{Binding CancelScanCommand}" Content="取消扫描" Style="{StaticResource DangerButton}" Margin="18,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>

    </StackPanel>
    <Grid Grid.Row="1" Margin="0,32,0,12">
        <TextBlock Text="文件分类" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock Text="选择一个分类查看明细" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
      </Grid>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,10,18,0">
      <ItemsControl ItemsSource="{Binding Categories}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- Badge 显示精确文件数量, Maximum 避免默认 99+ 截断. -->
            <hc:Badge Style="{StaticResource CategoryCountBadge}" Value="{Binding FileCount}" Maximum="999999" Margin="0,0,14,14">
              <Button Style="{StaticResource CategoryCardButton}" Command="{Binding DataContext.OpenCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Category}">
                <Border Width="210" Height="136" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Width="32" Height="32" Background="{StaticResource AccentSoftBrush}" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <StackPanel Grid.Row="1" Margin="0,10,0,0"><TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" /><TextBlock Text="点击查看文件明细" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0" /></StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding SizeText}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" />
                  </Grid>
                </Border>
              </Button>
            </hc:Badge>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>