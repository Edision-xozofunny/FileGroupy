<UserControl x:Class="FileGroupy.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style x:Key="CategoryCardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="48,42,48,48">
      <TextBlock Text="文件概览" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
      <TextBlock Text="扫描存储空间，整理每一种文件类型" Margin="0,7,0,28" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" />

      <!-- 使用 Card 统一承载当前扫描来源和来源切换操作. -->
      <hc:Card Header="扫描来源" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="26">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding SelectedPath}" FontSize="16" Margin="0,5,0,0" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding FolderInfo}" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding ErrorMessage}" Margin="0,8,0,0" Foreground="#D92D20" />
          </StackPanel>
          <Button Grid.Column="1" Command="{Binding RefreshCurrentCommand}" Content="刷新" Style="{StaticResource NeutralButton}" Padding="18,11" Margin="18,0,0,0" />
          <Button Grid.Column="2" Command="{Binding ChooseMtpDeviceCommand}" Style="{StaticResource SecondaryButton}" Padding="18,11" Margin="10,0,0,0">
            <TextBlock Text="选择便携设备" FontWeight="SemiBold" />
          </Button>
          <Button Grid.Column="3" Command="{Binding ChooseFolderCommand}" Style="{StaticResource PrimaryButton}" Padding="18,11" Margin="10,0,0,0">
            <TextBlock Text="选择文件夹" FontWeight="SemiBold" />
          </Button>
        </Grid>
      </hc:Card>

      <Border Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,16,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="正在扫描文件" FontWeight="SemiBold" Foreground="#175CD3" />
            <ProgressBar IsIndeterminate="True" Height="6" Margin="0,11,0,9" Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceMutedBrush}" />
            <TextBlock Text="{Binding ScanProgressText}" Foreground="#475467" />
          </StackPanel>
          <Button Grid.Column="1" Command="{Binding CancelScanCommand}" Content="取消扫描" Style="{StaticResource DangerButton}" Margin="18,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Grid Margin="0,32,0,12">
        <TextBlock Text="文件分类" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock Text="选择一个分类查看明细" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Categories}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- Badge 显示精确文件数量, Maximum 避免默认 99+ 截断. -->
            <hc:Badge Value="{Binding FileCount}" Maximum="999999" Margin="0,0,14,14">
              <Button Style="{StaticResource CategoryCardButton}" Command="{Binding DataContext.OpenCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Category}">
                <hc:Card Width="210" Height="136" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="17">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" Background="{StaticResource AccentSoftBrush}" CornerRadius="8"><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0"><TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" /><TextBlock Text="点击查看文件明细" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,7,0,0" /></StackPanel>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SizeText}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" />
                  </Grid>
                </hc:Card>
              </Button>
            </hc:Badge>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>